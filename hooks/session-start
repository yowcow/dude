#!/usr/bin/env bash
# SessionStart hook: put using-dude in context for the whole session.
#
# Claude Code reads a JSON object on stdout and injects
# hookSpecificOutput.additionalContext. The JSON string is escaped with bash
# parameter substitution rather than jq, because the hook has to run wherever
# the plugin is installed and jq is not guaranteed there.

set -euo pipefail

# CDPATH is cleared rather than trusted: `cd` searches it for a relative
# operand and echoes the directory it landed on, so an exported CDPATH would
# resolve this to a tree the hook was never invoked from and fold the echoed
# line into the value. That path is printed below as the block's identity, and
# a wrong identity is worse than none -- it is the line a reader trusts to tell
# two installs apart. Spelled as tests/lib/harness.sh and tests/run.sh spell it.
hook_dir="$(CDPATH='' cd -- "$(dirname "$0")" && pwd)"
# The install this hook is running out of. Two installs of dude each run their
# own copy of this script and inject a near-identical block; without the tree
# named in the block, the two cannot be told apart by reading them. The value
# was already being computed here and thrown away -- $CLAUDE_PLUGIN_ROOT is
# deliberately not consulted, so what is printed stays the tree this file
# actually ran from. `dirname` rather than ${hook_dir%/*}, which yields the
# empty string for a hook_dir of `/hooks`.
plugin_root="$(dirname "$hook_dir")"
skill_file="${plugin_root}/skills/using-dude/SKILL.md"

# On a read failure this says so in the injected context: a session that
# silently lost its workflow rules improvises every gate and looks normal.
skill_content=$(sed -n '/^# /,$p' "$skill_file" 2>&1) \
  || skill_content="Error reading the using-dude skill at ${skill_file}. dude's workflow rules are NOT in context; read the file yourself before starting any task."

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$skill_content")
# Through the same escape as the content: `"` and `\` are legal in a POSIX
# filename, and an install path carrying either would close the JSON string
# early -- taking the whole ruleset with it, not just the path.
escaped_root=$(escape_for_json "$plugin_root")

context="<EXTREMELY_IMPORTANT>\ndude's workflow rules — the \`dude:using-dude\` skill, in full, from the dude install at ${escaped_root}:\n\n${escaped}\n</EXTREMELY_IMPORTANT>"

# printf rather than a heredoc: bash 5.3+ hangs on heredocs in this position.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"

exit 0
